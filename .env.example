# Pigeon Server — sample configuration.
# Copy to `.env` and adjust before running.

# Secret for signing client JWTs and admin sessions.
# Generate e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"
PIGEON_SECRET_KEY=change-me-please-use-long-random-string

# Client JWT lifetime in hours. Default ~30 days.
PIGEON_JWT_TTL_HOURS=720

# Public server URL (used when building invite links in the admin UI).
# Example: https://pigeon.example.com
PIGEON_PUBLIC_URL=http://localhost:8000

# Bootstrap admin account. Created automatically on first startup if missing.
# You may remove these from .env after the admin exists in the database.
PIGEON_ADMIN_USERNAME=admin
PIGEON_ADMIN_PASSWORD=change-me-too

# How many days to retain undelivered ciphertext before TTL purge.
PIGEON_MESSAGE_TTL_DAYS=30

# Max ciphertext length per message (bytes).
PIGEON_MAX_CIPHERTEXT_BYTES=65536
